# SQLite database location for PING.
#
# Prisma resolves a relative file: path against the schema directory
# (prisma/), so this default creates prisma/db/custom.db — not ./db/custom.db.
# The server pins the path back to prisma/db/ at runtime so `prisma db push`
# and the running app always open the same file. Use an absolute path
# (file:/var/data/ping.db) if you want the database somewhere specific.
DATABASE_URL="file:./db/custom.db"

# Optional: require ?token=<secret> on /api/cron/tick so strangers can't
# trigger check runs. Generate one with: openssl rand -hex 16
# CRON_SECRET=""
