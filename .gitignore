*.log
dev.log
dev.out.log
logs/
*.pid
*.seed
*.tmp
tmp/

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ── Local development / sandbox artifacts (not part of the app) ─────────────
