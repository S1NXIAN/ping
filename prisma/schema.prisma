generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A folder groups monitors (e.g. "Render Free services")
model Folder {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  monitors  Monitor[]
}

// A monitored website / service
model Monitor {
  id             String    @id @default(cuid())
  name           String
  url            String
  method         String    @default("GET") // GET | HEAD
  intervalSec    Int       @default(300) // seconds between checks (min 60); used when scheduleMode = "interval"
  // How the check cadence is defined:
  //   "interval" → every intervalSec seconds (above)
  //   "times"    → at fixed clock times every day (scheduleTimes, in timezone)
  // Additive with a default, so rows written before this column keep working.
  scheduleMode   String    @default("interval") // "interval" | "times"
  // Comma-separated zero-padded "HH:MM" wall-clock times in `timezone`,
  // e.g. "03:00,13:00". Stored as wall clock (never instants) so the times
  // survive a timezone change or a DST shift as the times the user typed.
  // null = no times configured (an "interval" monitor).
  scheduleTimes  String?
  // IANA zone the times are read in, e.g. "Asia/Manila". null for interval
  // monitors; required when scheduleMode = "times".
  timezone       String?
  enabled        Boolean   @default(true)
  folderId       String?
  folder         Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  account        String? // optional label: which account/org runs this service
  pinned         Boolean   @default(false) // pinned monitors float to the top
  position       Int       @default(0) // manual order, ascending (within pinned/unpinned groups)
  // Optional keyword check: after a 2xx/3xx response, the (up to 256 KB of
  // the) body must contain — or must not contain — this case-insensitive
  // string for the monitor to count as up. Keyword checks always fetch with
  // GET (a HEAD response has no body). null = keyword checking off.
  keyword     String?
  keywordMode String  @default("contains") // "contains" | "excludes"
  // Optional latency-alert threshold in ms. When an UP check takes longer
  // than this, the monitor shows a "slow/degraded" state and (optionally)
  // fires a "slow" webhook. null = latency alerting off for this monitor.
  slowThresholdMs Int?
  // Alert delay: how many EXTRA consecutive failed checks must land before
  // a "down" webhook fires (0 = notify on the very first failure). Downtime
  // is always recorded honestly regardless of this setting — only the
  // notification waits for confirmation.
  alertDelay       Int       @default(0)
  // Running count of consecutive failed checks (reset by any success).
  consecutiveDowns Int       @default(0)
  incidentNotes  IncidentNote[]
  createdAt      DateTime  @default(now())
  lastCheckAt    DateTime?
  lastStatus     String? // "up" | "down"
  lastStatusCode Int?
  lastResponseMs Int?
  lastError      String?
  // Last status a webhook was actually sent for. Diverges from lastStatus
  // while an alert delay is still confirming a down, so a service that went
  // down during the delay still raises "down" once enough checks confirm it.
  lastNotifiedStatus String?
  checks         Check[]
  webhookChannels   WebhookChannel[]
}

// A postmortem/acknowledgment note the admin attaches to one derived
// incident (a down period). Matched to the incident by the exact timestamp
// of its first failed check — the same key the incident derivation uses —
// and shown on the public status page under that incident.
model IncidentNote {
  id        String   @id @default(cuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startedAt DateTime // first failed check of the incident
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([monitorId, startedAt])
}

// One health-check result. Only real, recorded checks exist here.
model Check {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status      String // "up" | "down"
  statusCode  Int?
  responseMs  Int?
  error       String?
  checkedAt   DateTime @default(now())

  // (monitorId, checkedAt): per-monitor history walks (recent checks,
  // retention prune, boundary lookups).
  @@index([monitorId, checkedAt])
  // (monitorId, status, checkedAt): covering index for the down-only scans
  // used by incident derivation, last-down lookups and day aggregations —
  // an all-up monitor never touches a row through this path.
  @@index([monitorId, status, checkedAt])
}

// Server-side sessions for the single-password auth
model Session {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A webhook endpoint notified when a monitor goes down or recovers.
// Each event is one fire-and-forget POST (10s timeout, no retries) —
// lastDelivery* fields record the honest outcome of the latest attempt.
// monitorId routes events for that monitor only; null = every monitor.
model WebhookChannel {
  id             String    @id @default(cuid())
  name           String
  url            String
  monitorId      String?
  monitor        Monitor?  @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  notifyDown     Boolean   @default(true)
  notifyUp       Boolean   @default(true)
  notifySlow     Boolean   @default(true) // "slow" events (latency threshold exceeded)
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  deliveries     Int       @default(0)
  lastDeliveryAt DateTime?
  lastOk         Boolean?
  lastError      String?
}

// Singleton row holding app settings (id = "main")
model Settings {
  id           String   @id @default("main")
  passwordHash String
  passwordSalt String
  // Check-history retention, configurable from Settings:
  //   null → default policy (30 days + 1,000-checks-per-monitor cap)
  //   0    → keep forever (only operational hygiene rows get cleaned)
  //   N>0  → keep N days (no per-monitor cap; explicit user choice)
  retentionDays Int?
  updatedAt    DateTime @updatedAt
}
