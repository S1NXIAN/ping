generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A folder groups monitors (e.g. "Render Free services")
model Folder {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  monitors  Monitor[]
}

// A monitored website / service
model Monitor {
  id             String    @id @default(cuid())
  name           String
  url            String
  method         String    @default("GET") // GET | HEAD
  intervalSec    Int       @default(300) // seconds between checks (min 60); used when scheduleMode = "interval"
  // How the check cadence is defined:
  //   "interval" → every intervalSec seconds (above)
  //   "times"    → at fixed clock times every day (scheduleTimes, in timezone)
  // Additive with a default, so rows written before this column keep working.
  scheduleMode   String    @default("interval") // "interval" | "times"
  // Comma-separated zero-padded "HH:MM" wall-clock times in `timezone`,
  // e.g. "03:00,13:00". Stored as wall clock (never instants) so the times
  // survive a timezone change or a DST shift as the times the user typed.
  // null = no times configured (an "interval" monitor).
  scheduleTimes  String?
  // IANA zone the times are read in, e.g. "Asia/Manila". null for interval
  // monitors; required when scheduleMode = "times".
  timezone       String?
  enabled        Boolean   @default(true)
  folderId       String?
  folder         Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  account        String? // optional label: which account/org runs this service
  pinned         Boolean   @default(false) // pinned monitors float to the top
  position       Int       @default(0) // manual order, ascending (within pinned/unpinned groups)
  // True for the one monitor PING creates to check its own health endpoint.
  // A durable marker so repeated boots never create a second one. Otherwise
  // it is an ordinary monitor: visible, editable and deletable.
  isSelfMonitor  Boolean   @default(false)
  // Optional keyword check: after a 2xx/3xx response, the (up to 256 KB of
  // the) body must contain — or must not contain — this case-insensitive
  // string for the monitor to count as up. A keyword needs a body, so it
  // can't be combined with a HEAD check — that pairing is rejected at create,
  // edit and import (see methodKeywordError). null = keyword checking off.
  keyword     String?
  keywordMode String  @default("contains") // "contains" | "excludes"
  // Optional latency threshold in ms. When an UP check takes longer than
  // this, the monitor shows a "slow/degraded" state. null = off for this
  // monitor.
  slowThresholdMs Int?
  incidentNotes  IncidentNote[]
  createdAt      DateTime  @default(now())
  lastCheckAt    DateTime?
  lastStatus     String? // "up" | "down"
  lastStatusCode Int?
  lastResponseMs Int?
  lastError      String?
  checks         Check[]
}

// A postmortem/acknowledgment note the admin attaches to one derived
// incident (a down period). Matched to the incident by the exact timestamp
// of its first failed check — the same key the incident derivation uses —
// and shown in the admin incidents sheet under that incident.
model IncidentNote {
  id        String   @id @default(cuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startedAt DateTime // first failed check of the incident
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([monitorId, startedAt])
}

// One health-check result. Only real, recorded checks exist here.
model Check {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status      String // "up" | "down"
  statusCode  Int?
  responseMs  Int?
  error       String?
  checkedAt   DateTime @default(now())

  // (monitorId, checkedAt): per-monitor history walks (recent checks,
  // retention prune, boundary lookups).
  @@index([monitorId, checkedAt])
  // (monitorId, status, checkedAt, responseMs): the fleet/detail aggregates
  // (uptime counts, avg/min/max latency) filter on checkedAt and group by
  // monitorId + status. Leading with monitorId + status lets each group be a
  // seek, and carrying responseMs makes the timing aggregates COVERING — no
  // row lookups. Measured at the 200-monitor/200k-row ceiling: the overview's
  // aggregate set drops ~5x (0.9s -> ~0.15s). Also serves the down-only scans
  // (incident derivation, last-down lookups) as the previous (monitorId,
  // status, checkedAt) index did.
  @@index([monitorId, status, checkedAt, responseMs])
}

// Server-side sessions for the single-password auth. A token never expires:
// it proves identity until logout or a password change, while `createdAt`
// drives the re-prompt window (see ping-auth.ts).
model Session {
  token     String   @id
  createdAt DateTime @default(now())
}

// Singleton row holding app settings (id = "main")
model Settings {
  id           String   @id @default("main")
  passwordHash String
  passwordSalt String
  // Check-history retention, configurable from Settings:
  //   null → default policy (30 days + 1,000-checks-per-monitor cap)
  //   0    → keep forever (only operational hygiene rows get cleaned)
  //   N>0  → keep N days (no per-monitor cap; explicit user choice)
  retentionDays Int?
  // Dashboard re-prompt window in minutes, counted from the last password
  // entry (no sliding). null → default (15). Constrained to SESSION_PRESETS
  // by the API.
  sessionMinutes Int?
  // Set when the operator deletes the Self-monitor, so a later boot or
  // authenticated request never recreates it against their wishes.
  selfMonitorDisabled Boolean @default(false)
  updatedAt    DateTime @updatedAt
}
