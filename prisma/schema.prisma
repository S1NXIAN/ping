generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A folder groups monitors (e.g. "Render Free services")
model Folder {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  monitors  Monitor[]
}

// A monitored website / service
model Monitor {
  id             String    @id @default(cuid())
  name           String
  url            String
  method         String    @default("GET") // GET | HEAD
  intervalSec    Int       @default(300) // seconds between checks (min 60)
  enabled        Boolean   @default(true)
  folderId       String?
  folder         Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  account        String? // optional label: which account/org runs this service
  pinned         Boolean   @default(false) // pinned monitors float to the top
  position       Int       @default(0) // manual order, ascending (within pinned/unpinned groups)
  statusHidden   Boolean   @default(false) // excluded from the public status page
  createdAt      DateTime  @default(now())
  lastCheckAt    DateTime?
  lastStatus     String? // "up" | "down"
  lastStatusCode Int?
  lastResponseMs Int?
  lastError      String?
  checks         Check[]
  scheduledPings ScheduledPing[]
}

// A one-off check explicitly scheduled for a specific moment
// (e.g. "ping my deploy at 09:00 right after it goes live").
model ScheduledPing {
  id         String    @id @default(cuid())
  monitorId  String
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  runAt      DateTime
  note       String?
  status     String    @default("pending") // pending | done
  ranAt      DateTime?
  up         Boolean?
  statusCode Int?
  responseMs Int?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
  @@index([monitorId, status])
}

// One health-check result. Only real, recorded checks exist here.
model Check {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status      String // "up" | "down"
  statusCode  Int?
  responseMs  Int?
  error       String?
  checkedAt   DateTime @default(now())

  @@index([monitorId, checkedAt])
}

// Server-side sessions for the single-password auth
model Session {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A webhook endpoint notified when a monitor goes down or recovers.
// Each event is one fire-and-forget POST (10s timeout, no retries) —
// lastDelivery* fields record the honest outcome of the latest attempt.
model WebhookChannel {
  id             String    @id @default(cuid())
  name           String
  url            String
  notifyDown     Boolean   @default(true)
  notifyUp       Boolean   @default(true)
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  deliveries     Int       @default(0)
  lastDeliveryAt DateTime?
  lastOk         Boolean?
  lastError      String?
}

// Singleton row holding app settings (id = "main")
model Settings {
  id           String   @id @default("main")
  passwordHash String
  passwordSalt String
  statusToken  String? // public status-page token; null = page disabled
  statusTitle  String? // optional custom title shown on the public status page
  updatedAt    DateTime @updatedAt
}
